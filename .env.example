# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-in-production
DB_HOST=db
DB_PORT=5432
DB_NAME=inventree
DB_USER=inventree
DB_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=postgresql://inventree:change-in-production@127.0.0.1:5433/inventree

# ─── Cache ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-in-production
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_URL=redis://:$REDIS_PASSWORD@$REDIS_HOST:$REDIS_PORT

# --- Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Security ───────────────────────────────────────────────────────────────-
OBFUSCATION_KEY=5ac5e1bab49a228988b3a6dc9bb03c8438ee055a20c0c1045787014a5a53537cb4e8a96c04c8694c4ed5a627ae5a65ef2780d22295e809b589a45071ede185c6

# --- Mail --------------------------------------------------------------------
MAIL_PROVIDER=smtp
SMTP_HOST=mailer
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASSWORD=test
SMTP_FROM="InvenTree <noreply@inventree.local>"

# ─── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8257

SYSTEM_NAME=InvenTree Systems
API_URL=http://localhost:8257

JWT_ACCESS_SECRET=change-in-production
JWT_ACCESS_TTL=1d
JWT_REFRESH_SECRET=change-in-production
JWT_REFRESH_TTL=7d
JWT_UTIL_SECRET=change-in-production
JWT_ISSUER="INVENTREE_BACKEND"
JWT_AUDIENCE="INVENTREE_CLIENTS"

LOG_LEVEL=debug # To enable debug logging, set to "debug". For production, set to "info" or "warn".