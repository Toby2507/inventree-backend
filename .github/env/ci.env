# ─── Database ────────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD -> Github Secret: CI_POSTGRES_PASSWORD
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventree
DB_USER=inventree
# DB_PASSWORD -> Github Secret: CI_POSTGRES_PASSWORD

# ─── Cache ───────────────────────────────────────────────────────────────────
# REDIS_PASSWORD -> No password needed for CI redis — no --requirepass set on the sidecar
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Security ───────────────────────────────────────────────────────────────-
CRYPTOGRAPHY_KEY=5ac5e1bab49a228988b3a6dc9bb03c8438ee055a20c0c1045787014a5a53537cb4e8a96c04c8694c4ed5a627ae5a65ef2780d22295e809b589a45071ede185c6

# --- Mail --------------------------------------------------------------------
MAIL_PROVIDER=fake

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=8257
NODE_ENV=test

SYSTEM_NAME=InvenTree Systems
API_URL=http://localhost:8257

# JWT_ACCESS_SECRET  → GitHub Secret: CI_JWT_ACCESS_SECRET
JWT_ACCESS_TTL=1d
# JWT_REFRESH_SECRET → GitHub Secret: CI_JWT_REFRESH_SECRET
JWT_REFRESH_TTL=7d
# JWT_UTIL_SECRET    → GitHub Secret: CI_JWT_UTIL_SECRET
JWT_ISSUER=INVENTREE_BACKEND
JWT_AUDIENCE=INVENTREE_CLIENTS

LOG_LEVEL=silent